#!/usr/bin/env python3
import json
import subprocess
import sys
from pathlib import Path


REPOSITORIES = Path("infra/services/github/repositories")
MODULES = Path("infra/services/github/modules")
ROOT_CONFIG = "module_gh_repo_kit.tf"
TOOLCHAIN = ("flake.nix", "flake.lock")


def repository_config(root):
    path = REPOSITORIES / root / ROOT_CONFIG
    document = json.loads(subprocess.check_output(["hcl2json", path]))
    modules = document.get("module", {}).get("repository", [])
    if len(modules) != 1 or modules[0].get("name") != root:
        sys.exit(f"{path} must declare exactly one module.repository with name {root!r}")
    if not isinstance(modules[0].get("source"), str):
        sys.exit(f"{path} must declare a string module.repository.source")
    return modules[0]


def local_module(root):
    source = Path(repository_config(root)["source"])
    if source.parent == Path("../../modules"):
        return source.name
    return None


def changed_roots(roots, changes, plan):
    paths = {Path(file["path"]) for file in (changes["files"] or [])}
    if any(path.as_posix() in TOOLCHAIN or
           (plan and path.is_relative_to("policy/terraform")) for path in paths):
        return roots

    directories = {Path(directory["path"]) for directory in (changes["dirs"] or [])}
    direct = {path.name for path in directories if path.parent == REPOSITORIES}
    modules = {
        path.parts[len(MODULES.parts)]
        for path in paths
        if path.is_relative_to(MODULES) and len(path.parts) > len(MODULES.parts) + 1
    }
    affected = {root for root in roots if modules and local_module(root) in modules}
    return (roots & direct) | affected


mode = sys.argv[1]
if mode == "name":
    print(repository_config(sys.argv[2])["name"])
    sys.exit(0)

if mode == "current":
    root, base, head = sys.argv[2:]
    paths = [str(REPOSITORIES / root), *TOOLCHAIN]
    module = local_module(root)
    if module:
        paths.append(str(MODULES / module))
    difference = subprocess.run(["git", "diff", "--quiet", base, head, "--", *paths])
    if difference.returncode not in {0, 1}:
        difference.check_returncode()
    print("true" if difference.returncode == 0 else "false")
    sys.exit(0)

roots = {file.parent.name for file in REPOSITORIES.glob(f"*/{ROOT_CONFIG}")}
if mode in {"plan", "apply"}:
    roots = changed_roots(roots, json.load(sys.stdin), plan=mode == "plan")
elif mode != "all":
    sys.exit(f"Unknown mode: {mode}")
print(json.dumps(sorted(roots), separators=(",", ":")))
