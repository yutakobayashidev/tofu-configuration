# 1Password secret references for running OpenTofu locally. The file holds
# references only, never secret values. Run any root through op run:
#
#   op run --env-file=op.env -- tofu -chdir=infra/global plan
#
# The GitHub repository roots use Google Cloud credentials instead; see
# docs/github-management.md.

# R2 backend for every root except the GitHub roots.
AWS_REGION=auto
AWS_ACCESS_KEY_ID=op://Personal/tofu-configuration-r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://Personal/tofu-configuration-r2/secret_access_key
AWS_ENDPOINT_URL_S3=op://Personal/tofu-configuration-r2/endpoint

# State and plan encryption ("GitHub OpenTofu state").
TF_VAR_state_encryption_passphrase=op://Personal/x27pxazcyxrustxe2lw4xloocu/password

# infra/global
TF_VAR_cloudflare_api_token=op://Personal/tofu-configuration-global/cloudflare_api_token
TF_VAR_cloudflare_account_id=op://Personal/tofu-configuration-global/cloudflare_account_id
TF_VAR_cloudflare_zone_id=op://Personal/tofu-configuration-global/cloudflare_zone_id
TF_VAR_domain=op://Personal/tofu-configuration-global/domain
TF_VAR_mastodon_media_bucket_name=op://Personal/tofu-configuration-global/mastodon_media_bucket_name
TF_VAR_mastodon_media_custom_domain=op://Personal/tofu-configuration-global/mastodon_media_custom_domain
TF_VAR_nix_cache_custom_domain=op://Personal/tofu-configuration-global/nix_cache_custom_domain
TF_VAR_tunnel_secret=op://Personal/tofu-configuration-global/tunnel_secret

# infra/services/discord/yuta-studio ("Discord bot token (yuta-studio)").
DISCORD_TOKEN=op://Personal/axjl7fgzvu35kaxugpmbhjuhai/credential
